{
  "name": "gif-studio",
  "version": "1.0.0",
  "description": "Gif Studio - Modifica Foto e GIF Premium",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.gifstudio.app",
    "productName": "Gif Studio",
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "gifstudio-portable.${ext}"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "main.js"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
